SCYLLA=/srv/scylla

@reboot          mkdir -p $SCYLLA/results/logs && $SCYLLA/tools/server/fuzz.sh    >> $SCYLLA/results/logs/fuzz.log    2>&1
30 1 * * *       mkdir -p $SCYLLA/results/logs && $SCYLLA/tools/server/nightly.sh >> $SCYLLA/results/logs/nightly.log 2>&1
30 4 * * 6       mkdir -p $SCYLLA/results/logs && $SCYLLA/tools/server/weekly.sh  >> $SCYLLA/results/logs/weekly.log  2>&1
